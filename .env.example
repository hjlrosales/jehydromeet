# ============================================================================
# Jehydro Meet - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored - never commit secrets.
#
# Sections:
#   1. Base (backend)     - always needed
#   2. TURN               - Coturn shared-secret auth
#   3. SFU (LiveKit)      - media server for >8 participants
#   4. Recording          - LiveKit Egress (depends on SFU)
#   5. Frontend           - Next.js public vars
#   6. E2E Tests          - Playwright overrides (optional)
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Base - Backend server configuration
# ---------------------------------------------------------------------------
# PORT=4000                                     # HTTP server port
# CORS_ORIGIN=https://jehydro.com                # Allowed CORS origin
# ROOM_EMPTY_TTL_MIN=10                         # Auto-destroy empty rooms after N min
# MAX_ROOMS_PER_IP_PER_HOUR=20                  # Abuse guardrail
# REDIS_URL=redis://redis:6379                   # Socket.IO adapter (multi-instance backend)

# ---------------------------------------------------------------------------
# 2. TURN - Coturn shared-secret authentication
# ---------------------------------------------------------------------------
# Required for NAT traversal (CGNAT, mobile, corporate firewalls).
# Generate secret: openssl rand -hex 32
# TURN_SECRET=changeme                           # Must match coturn.conf
# TURN_URLS=turn:turn.jehydro.com:3478,turns:turn.jehydro.com:5349  # Comma-separated TURN URLs (TCP + TLS)

# ---------------------------------------------------------------------------
# 3. SFU - LiveKit media server (>8 participants)
# ---------------------------------------------------------------------------
# Only needed if you plan to use SFU mode.
# LIVEKIT_API_KEY=                               # From livekit.yaml
# LIVEKIT_API_SECRET=                            # From livekit.yaml
# LIVEKIT_URL=ws://localhost:7880                # WebSocket URL (or wss:// in prod)

# ---------------------------------------------------------------------------
# 4. Recording - LiveKit Egress (requires SFU vars above)
# ---------------------------------------------------------------------------
# RECORDING_STORAGE_PATH=./recordings            # Output directory
# RECORDING_RETENTION_DAYS=7                     # Auto-delete after N days
# RECORDING_MAX_STORAGE_GB=10                    # Max storage capacity

# ---------------------------------------------------------------------------
# 7. Database (Phase 15) — PostgreSQL for accounts, history, file sharing
# ---------------------------------------------------------------------------
# Required for Phase 15 features (accounts, meeting history, scheduled meetings,
# file sharing, and recording persistence).
# The full connection string Prisma uses to connect.
# For local dev: postgresql://jehydro:changeme@localhost:5432/jehydro_meet
# DATABASE_URL=

# ---------------------------------------------------------------------------
# 8. Auth (Phase 15) — JWT secret for session tokens
# ---------------------------------------------------------------------------
# A random hex string used to sign and verify JWT tokens.
# Generate with: openssl rand -hex 64
# JWT_SECRET=

# ---------------------------------------------------------------------------
# 9. File Upload (Phase 15) — Path + expiry
# ---------------------------------------------------------------------------
# FILE_UPLOAD_PATH=./uploads
# FILE_MAX_SIZE_MB=25
# FILE_EXPIRY_HOURS=24

# ---------------------------------------------------------------------------
# 5. Frontend - Next.js public environment variables
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# ---------------------------------------------------------------------------
# 6. E2E Tests - Playwright test URLs (override defaults)
# ---------------------------------------------------------------------------
# FRONTEND_URL=http://localhost:3000
# BACKEND_URL=http://localhost:4000
