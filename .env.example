# Jehydro Meet — Environment Variables
# Copy to .env and fill in production values.

# ============================================================
# Backend — Express + Socket.IO signaling server
# ============================================================

# Port the backend listens on (default: 4000)
PORT=4000

# Allowed CORS origin (production: https://jehydro.com)
CORS_ORIGIN=https://jehydro.com

# TURN server shared secret for HMAC credential generation
# Generate with: openssl rand -hex 32
TURN_SECRET=change-me-to-a-random-64-char-hex-string

# Comma-separated TURN URLs sent to clients
TURN_URLS=turn:turn.jehydro.com:3478,turns:turn.jehydro.com:5349

# Minutes to keep an empty room alive before garbage collection (default: 10)
ROOM_EMPTY_TTL_MIN=10

# Maximum number of rooms a single IP can create per hour (default: 20)
MAX_ROOMS_PER_IP_PER_HOUR=20

# LiveKit SFU server credentials (required for SFU mode, >8 participants)
# Generate API key/secret pair:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit server URL (WebSocket URL for clients to connect)
LIVEKIT_URL=ws://localhost:7880

# Redis URL for Socket.IO adapter (optional, for multi-instance backend)
# REDIS_URL=redis://redis:6379

# ============================================================
# Frontend — Next.js
# ============================================================

# Backend URL that the browser connects to (production: https://meet-api.jehydro.com)
NEXT_PUBLIC_BACKEND_URL=https://meet-api.jehydro.com

# JSON array of ICE servers sent to browser WebRTC clients
NEXT_PUBLIC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
