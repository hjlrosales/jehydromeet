# Jehydro Meet — Frontend Dockerfile
# Full Docker setup in Phase 8. For development, use `pnpm dev`.

FROM node:20-alpine AS builder
WORKDIR /app
COPY apps/frontend/package.json ./
RUN npm install
COPY apps/frontend/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/out /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
