# Jehydro Meet — Backend Dockerfile
# Full Docker setup in Phase 8. For development, use `pnpm dev`.

FROM node:20-alpine AS builder
WORKDIR /app
COPY apps/backend/package.json ./
RUN npm install
COPY apps/backend/ .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 4000
CMD ["node", "dist/index.js"]
