{
  "name": "jehydro-meet",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based video conferencing platform (Zoom/Meet style)",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"pnpm --filter @jehydro/frontend dev\" \"pnpm --filter @jehydro/backend dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "report:open": "pnpm --filter @jehydro/frontend report:open",
    "validate:env": "node scripts/validate-env.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
